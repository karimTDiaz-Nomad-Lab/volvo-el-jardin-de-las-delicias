# Copy to `.env.local` for local dev. Server loads it automatically.

# ── 1) AI (server only) ─────────────────────────────────────────────────────
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── 2) Kiosk API gate ───────────────────────────────────────────────────────
API_KEY=local-dev-kiosk-key
VITE_KIOSK_API_KEY=local-dev-kiosk-key

# ── 3) Client pack ──────────────────────────────────────────────────────────
VITE_CLIENT_ID=volvo
VITE_DISPLAY=mupi
VITE_FRAME_ASPECT_RATIO=2:3

# ── Optional ────────────────────────────────────────────────────────────────
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_IMAGE_SIZE=1K
# PORT=8080
# Portrait MUPI camera (mounted sideways). Use 0 for an upright laptop webcam.
# VITE_CAMERA_ROTATION_DEG=-90
# Optional override. Leave unset so the booth uses the laptop/built-in webcam
# instead of leftover Canon EOS Webcam Utility devices.
# VITE_CAMERA_DEVICE_LABEL=

# ── 4) DigitalOcean Spaces CDN (QR share — kiosk server only) ──────────────
# Portraits go under DO_SPACES_PREFIX. No App Platform required.
DO_SPACES_BUCKET=no-madproject
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACES_CDN=https://no-madproject.ams3.cdn.digitaloceanspaces.com
DO_SPACES_PREFIX=volvo-jardin/portraits
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
